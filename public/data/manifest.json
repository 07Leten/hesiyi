{
  "version": 1,
  "instruments": "instruments.json",
  "packs": [
    {
      "id": "demo",
      "label": "演示数据包",
      "origin": "demo",
      "description": "词牌简介与词作正文据通行资料录入，未经善本校对；曲谱为本项目为演示播放功能编写的旋律，并非任何历史文献曲谱。",
      "base": "demo/",
      "files": {
        "tunePatterns": "tune-patterns.json",
        "authors": "authors.json",
        "poems": "poems.json",
        "scores": "scores.json",
        "performances": "performances.json"
      }
    },
    {
      "id": "predicted",
      "label": "模型预测谱",
      "origin": "model",
      "description": "由模型预测得到的旋律，同一词牌常有两份。不是文献译谱，也未经人工审定。",
      "base": "predicted/",
      "files": {
        "tunePatterns": "tune-patterns.json",
        "authors": "authors.json",
        "poems": "poems.json",
        "scores": "scores.json",
        "performances": "performances.json"
      }
    },
    {
      "id": "restored",
      "label": "唱词清理谱",
      "origin": "restore",
      "description": "魏氏乐谱识谱稿，只保留唱词。其中若干首已按重新识别的勘误谱替换，其余仍是原先的清理稿。都还不是审定稿。",
      "base": "restored/",
      "files": {
        "tunePatterns": "tune-patterns.json",
        "authors": "authors.json",
        "poems": "poems.json",
        "scores": "scores.json",
        "performances": "performances.json"
      }
    },
    {
      "id": "weishi",
      "label": "《魏氏乐谱今译》文献数据包（待导入）",
      "origin": "literature",
      "description": "导入真实文献曲谱时启用此项，并在 weishi/ 目录下放置同结构的 JSON 文件。",
      "base": "weishi/",
      "enabled": false,
      "files": {
        "tunePatterns": "tune-patterns.json",
        "poems": "poems.json",
        "scores": "scores.json",
        "performances": "performances.json"
      }
    }
  ]
}
